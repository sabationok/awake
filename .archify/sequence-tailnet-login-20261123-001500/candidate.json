  "cards": [
    {
      "dot": "emerald",
      "title": "Що причіплюється",
      "items": [
        "Браузер: Cookie mc_device + mc_session (same-origin, сам)",
        "tailscale serve: Tailscale-User-Login, TLS знімає він",
        "Порт 47802 на 127.0.0.1 — ознака «прийшло з tailnet»"
      ]
    },
    {
      "dot": "rose",
      "title": "Що відліплюється",
      "items": [
        "serve вирізає підроблені клієнтом Tailscale-* хедери",
        "Bearer-токен і localStorage більше не потрібні",
        "logout: mc_session гасне, mc_device лишається"
      ]
    },
    {
      "dot": "orange",
      "title": "Що вирішує guard",
      "items": [
        "не власник tailnet → 403",
        "лише mc_device → пейринг і auth/login",
        "mc_device + жива сесія → усі роути"
      ]
    }
  ]
